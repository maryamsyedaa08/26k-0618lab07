#include <stdio.h>

int main()
{
    int stock[] = {25, 12, 8, 40, 5, 18, 3, 22};
    int n = sizeof(stock) / sizeof(stock[0]);
    int i, item, sold;
    int total = 0, least = 0;

    printf("Initial Stock:\n");

    for (i = 0; i < n; i++)
    {
        printf("Item %d: %d units\n", i + 1, stock[i]);

        if (stock[i] < 10)
            printf("Item %d is LOW on stock - reorder required\n",
                   i + 1);
    }

    while (1)
    {
        printf("\nEnter item number (0 to stop): ");
        scanf("%d", &item);

        if (item == 0)
            break;

        if (item < 1 || item > n)
        {
            printf("Invalid item number.\n");
            continue;
        }

        printf("Enter quantity sold: ");
        scanf("%d", &sold);

        if (sold < 0 || sold > stock[item - 1])
        {
            printf("Invalid sale. Stock unchanged.\n");
        }
        else
        {
            stock[item - 1] = stock[item - 1] - sold;
        }
    }

    printf("\nFinal Stock:\n");

    for (i = 0; i < n; i++)
    {
        printf("Item %d: %d units\n", i + 1, stock[i]);

        total = total + stock[i];

        if (stock[i] < stock[least])
            least = i;
    }

    printf("Total units remaining: %d\n", total);
    printf("Item with least stock: Item %d\n", least + 1);
    printf("Least stock quantity: %d\n", stock[least]);

    return 0;
}